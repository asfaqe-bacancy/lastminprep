# PrepSprint environment
#
# Copy this file to `.env.local` and fill it in:
#
#   cp .env.example .env.local
#
# Without these values the app still runs: it falls back to preview data so
# every screen can be looked at, and says plainly where a key is missing.
# Restart the dev server after editing this file.

# --- Gemini -------------------------------------------------------------
# Writes plans, teaches topics, asks and marks questions, runs the interview.
# Get a key at https://aistudio.google.com/apikey
# Server-side only. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=

# --- Supabase -----------------------------------------------------------
# Project settings → API in the Supabase dashboard.
# These two are sent to the browser by design; Row Level Security is what
# keeps one user out of another's data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses Row Level Security. Used only by the document pipeline, which
# writes chunks and embeddings on a user's behalf after checking ownership.
# Server-side only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
